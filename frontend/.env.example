# ─── Frontend Environment ─────────────────────────────────────────────────────
# Copy this to .env.local and fill in your values

# Solver API base URL
NEXT_PUBLIC_SOLVER_API=http://localhost:4000

# VeilSolver.sol address on 0G Chain
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# Compressed secp256k1 public key (33 bytes) of the solver wallet
# Derive: new ethers.SigningKey(PRIVATE_KEY).compressedPublicKey
NEXT_PUBLIC_SOLVER_PUBKEY=0xYOUR_SOLVER_PUBKEY

# ERC20 token addresses on 0G Chain
NEXT_PUBLIC_TOKEN_IN=0xYOUR_TOKEN_IN_ADDRESS
NEXT_PUBLIC_TOKEN_OUT=0xYOUR_TOKEN_OUT_ADDRESS

# 0G Chain ID: 16602 = testnet, 16661 = mainnet
NEXT_PUBLIC_CHAIN_ID=16602
