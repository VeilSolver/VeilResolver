# ─── Frontend Environment ──────────────────────────────────────────────────────
# Copy to .env.local and fill in values

# Solver API base URL (Railway/Fly.io in prod, localhost for dev)
NEXT_PUBLIC_SOLVER_API=https://your-solver-api.railway.app

# ─── Mainnet (chainId 16661) — production ─────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=16661
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_MAINNET_CONTRACT
NEXT_PUBLIC_SOLVER_PUBKEY=0xYOUR_COMPRESSED_PUBKEY_33BYTES
NEXT_PUBLIC_TOKEN_IN=0xYOUR_MAINNET_USDC
NEXT_PUBLIC_TOKEN_OUT=0xYOUR_MAINNET_WETH

# ─── Testnet (chainId 16602) — local dev ──────────────────────────────────────
# NEXT_PUBLIC_CHAIN_ID=16602
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x02553ef7529118EB33E199b7329732d4F2884cEb
# NEXT_PUBLIC_SOLVER_PUBKEY=0x039a5b81f4b2bc0c181b1292f3aeb55721de43dc7e3d07c6c44ba3aa08e7caae04
# NEXT_PUBLIC_TOKEN_IN=0x0683F96B376cd819C12Bdb0c723b7D508ceF42Cf
# NEXT_PUBLIC_TOKEN_OUT=0x2550713236C759e185068ba531E2f63dc0de41D2
# NEXT_PUBLIC_SOLVER_API=http://localhost:4000

# ─── How to get SOLVER_PUBKEY ──────────────────────────────────────────────────
# node -e "const {ethers}=require('ethers'); console.log(new ethers.SigningKey('0xYOUR_KEY').compressedPublicKey)"
