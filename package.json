{
  "name": "veilsolver",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "solver-api",
    "sdk"
  ],
  "scripts": {
    "dev:api": "pnpm --filter=solver-api run dev",
    "dev:frontend": "pnpm --filter=frontend run dev",
    "start:api": "pnpm --filter=solver-api run start",
    "build": "pnpm --filter=veilsolver-sdk run build && pnpm --filter=frontend run build"
  },
  "dependencies": {
    "motion": "^12.38.0"
  }
}
