# ─── Solver API Environment ────────────────────────────────────────────────────
# Copy to .env and fill in values

# Wallet private key — signs execution plans
SOLVER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# 0G AI router API key (get from https://og.ai or 0G compute portal)
OG_API_KEY=app-sk-...

# testnet | mainnet
NETWORK=mainnet

# Server port
PORT=4000

# ─── Contract + Token Addresses ────────────────────────────────────────────────
# Populated after running: forge script script/Deploy.s.sol --broadcast

# Mainnet (chainId 16661)
CONTRACT_ADDRESS=0xYOUR_MAINNET_CONTRACT
TOKEN_IN=0xYOUR_MAINNET_USDC
TOKEN_OUT=0xYOUR_MAINNET_WETH
DEX_ROUTER=0xYOUR_MAINNET_DEX_ROUTER
SOLVER_ADDRESS=0xYOUR_SOLVER_WALLET_ADDRESS

# ─── Testnet (chainId 16602) — for local dev ───────────────────────────────────
# CONTRACT_ADDRESS=0x02553ef7529118EB33E199b7329732d4F2884cEb
# TOKEN_IN=0x0683F96B376cd819C12Bdb0c723b7D508ceF42Cf
# TOKEN_OUT=0x2550713236C759e185068ba531E2f63dc0de41D2
# DEX_ROUTER=0xcA6479CA8426C715EB9A9F22d6827a785cA0E6e8
# NETWORK=testnet
