# ─── Solver API Environment ───────────────────────────────────────────────────
# Copy this to .env and fill in your values

# Your wallet private key — this signs execution plans
# In production this lives inside a TEE
SOLVER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# GLM-5-FP8 TeeML provider on 0G Compute
# Get from: 0g-compute-cli inference list-providers
GLM5_PROVIDER_ADDRESS=0xd9966e...

# testnet | mainnet
NETWORK=testnet

# Server port
PORT=4000
